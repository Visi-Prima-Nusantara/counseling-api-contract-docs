						"in": "query",
						"name": "academic_year_id",
						"required": true,
						"schema": {
							"format": "double",
							"type": "number"
						}
					},
					{
						"description": "Get list of report created by me, my-students, my-kids, teachers, students",
						"in": "query",
						"name": "from",
						"required": false,
						"schema": {
							"default": "me",
							"type": "string",
							"enum": [
								"my-students",
								"my-kids",
								"teachers",
								"students",
								"me"
							]
						}
					},
					{
						"description": "Filter reports by status, comma separated string can be one of `REVIEW = 0`, `FOLLOW_UP = 1`, `DONE = 2`, `REJECTED = 3`, e.g. \"0,1,2\"",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				]
