			"post": {
				"operationId": "CrateBullyingReport",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ResponseEnvelope_BullyingReport_"
								}
							}
						}
					}
				},
				"description": "Create a new bullying report, **a report can only be created by a student or teacher**.",
				"summary": "Create a new bullying report",
				"tags": [
					"Anti-Bullying"
				],
				"security": [],
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"properties": {
									"types": {
										"type": "string",
										"description": "Types of bullying, can be `PHYSICAL = 0`, `VERBAL = 1`, `SOCIAL = 2`, `CYBER = 3`, `OTHER = 4`, comma separated, e.g. \"0,1,2\""
									},
									"other_type": {
										"type": "string",
										"description": "Other type of bullying, if `types` contains `OTHER = 4`, this field is required otherwise will be empty string"
									},
									"date": {
										"type": "string",
										"description": "ISO 8601 date string, e.g. \"2023-10-01T12:00:00Z\""
									},
									"locations": {
										"type": "string",
										"description": "Locations of the incident, can be `CLASSROOM = 0`, `CANTEEN = 1`, `SCHOOL_YARD = 2`, `TOILET = 3`, `OTHER = 4`, comma separated, e.g. \"0,1,2\""
									},
									"other_location": {
										"type": "string",
										"description": "Other location of the incident, if `locations` contains `OTHER = 4`, this field is required otherwise will be empty string"
									},
									"has_witness": {
										"type": "string",
										"description": "Whether there are witnesses to the incident"
									},
									"description": {
										"type": "string",
										"description": "Description of the incident"
									},
									"is_anonymous": {
										"type": "string",
										"description": "Whether the report is anonymous"
									},
									"perpetrator_name": {
										"type": "string",
										"description": "Name of the perpetrator (Can be empty)"
									},
									"victim_name": {
										"type": "string",
										"description": "Name of the victim (Can be empty)"
									},
									"attachment": {
										"type": "string",
										"format": "binary",
										"description": "Attachment (Can be empty)"
									}
								},
								"required": [
									"types",
									"date",
									"locations",
									"has_witness",
									"description",
									"is_anonymous",
									"perpetrator_name",
									"victim_name"
								]
							}
						}
					}
				}
			}
		},
